# Development
DEBUG=True
PRODUCTION=False

# Production
DB_NAME=<nama database>
DB_HOST=<host database>
DB_PORT=<port database>
DB_USER=<username database>
DB_PASSWORD=<password database>
SCHEMA=<schema name>
DEBUG=False
PRODUCTION=True

# PNPM Bin (sesuaikan)
NPM_BIN_PATH="C:\Program Files\nodejs\pnpm.CMD"

# Absolute private photo directory outside this checkout; not publicly served.
WARDROBE_PRIVATE_ROOT=/absolute/path/outside/repository/private-wardrobe

OUTFITS_PROVIDER=api
OUTFITS_PREVIEW_ENABLED=True
OUTFITS_PREVIEW_MAX_REQUESTS=20

# Discovery Map providers
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
IP_GEOLOCATION_URL=https://ipapi.co/{ip}/json/
LOCATION_USER_AGENT="Sirkula/1.0 (admin@sirkula.com)"
LOCATION_REQUEST_TIMEOUT=5
LOCATION_CACHE_SECONDS=86400

# AI Backend API
WARDROBE_API_URL=https://sirkula-ai.sunflair.dev
WARDROBE_SECRET=<nilai-secret-minta-zayyan-di-grup>

# Midtrans QRIS
MIDTRANS_SERVER_KEY=SB-Mid-server-xxxxxxxx
MIDTRANS_IS_PRODUCTION=False
MIDTRANS_QRIS_ACQUIRER=gopay
